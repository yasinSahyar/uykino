# .env is better suited for public variables, ie, variables that should not commited
# For secret variables is better to use DevServerControl tool with set_env_variable: ["KEY", "SECRET"]

# https://www.builder.io/c/docs/using-your-api-key
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__
PING_MESSAGE="ping pong"

# AWS S3 Configuration
# Get these credentials from AWS IAM console: https://console.aws.amazon.com/iam/
# Create an IAM user with S3FullAccess policy
AWS_REGION=us-east-1
AWS_BUCKET_NAME=sazkino-uploads
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY should be set as environment secrets
# They should NOT be committed to version control
